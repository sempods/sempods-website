---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** schema.org type for this page's JSON-LD. */
  schemaType?: 'WebSite' | 'TechArticle' | 'WebPage';
  /** Wide measure for pages that carry tables or long code. */
  wide?: boolean;
}

const {
  title,
  description,
  schemaType = 'WebPage',
  wide = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
/*
 * One card for the whole site, absolute because a scraper does not resolve
 * relative URLs. The file is copied from sempods-spec/docs/brand, which is the
 * source of truth for the mark — a second drawing here would drift from it.
 */
const socialImage = new URL('/images/sempods-social-preview.png', Astro.site);
const measure = wide ? 'measure-wide' : 'measure';
const currentPath = Astro.url.pathname;
const ogType = schemaType === 'WebSite' ? 'website' : 'article';

/*
 * Structured data on every page, and it is not an SEO trick here: a project that
 * argues for machine-readable knowledge and ships a page whose own markup says
 * nothing would be refuted by its own source. These are the same fields the
 * frontmatter carries, which is what makes the site the first vault rather than
 * a page about one.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: title,
  ...(schemaType === 'TechArticle' ? { headline: title } : {}),
  description,
  url: canonical.href,
  inLanguage: 'en',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical.href,
  },
  isPartOf: {
    '@type': 'WebSite',
    name: 'sempods',
    url: 'https://www.sempods.org',
  },
  publisher: {
    '@type': 'Organization',
    name: 'sempods',
    url: 'https://www.sempods.org',
    email: 'hello@sempods.org',
    logo: 'https://www.sempods.org/favicon.svg',
  },
};

const nav = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/concepts', label: 'Concepts' },
  { href: '/use-cases', label: 'Use cases' },
  { href: '/start', label: 'Start' },
  { href: '/roadmap', label: 'Roadmap' },
  { href: '/search', label: 'Search' },
];

const isCurrentNavItem = (href: string) => {
  const normalizedHref = href.endsWith('/') ? href : `${href}/`;
  return currentPath === href || currentPath.startsWith(normalizedHref);
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="/images/sempods-mark.svg" color="#111111" />
    <meta name="theme-color" content="#fbfaf8" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="sempods" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="sempods — your data belongs to you" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage.href} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <header class="site-head">
      <div class="measure-wide row">
        <a class="wordmark" href="/">
          <span class="wordmark-mark" aria-hidden="true"></span>
          <span>sempods</span>
        </a>
        <nav class="site-nav">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={{ active: isCurrentNavItem(item.href) }}
                aria-current={isCurrentNavItem(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <!-- Pagefind indexes the article, not the chrome: without this the nav and
         footer land in every result's excerpt. -->
    <main data-pagefind-body>
      <div class={measure}>
        <slot />
      </div>
    </main>

    <footer class="site-foot">
      <div class="measure-wide">
        <p>
          sempods is a specification with a reference implementation. Code under
          Apache&nbsp;2.0, documentation under CC&nbsp;BY&nbsp;4.0.
        </p>
        <!-- The sentence above names two things; the links have to reach both,
             or the site points only at the implementation. -->
        <ul class="footer-links" aria-label="Project links">
          <li><a href="https://spec.sempods.org">Specification</a></li>
          <li><a href="https://github.com/sempods/sempods-kotlin">Reference implementation</a></li>
          <li><a href="https://github.com/sempods/sempods-kotlin/discussions">Discussions</a></li>
          <li><a href="mailto:hello@sempods.org">hello@sempods.org</a></li>
          <li><a href="/links">All links</a></li>
        </ul>
      </div>
    </footer>

  </body>
</html>
